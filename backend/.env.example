APP_NAME=HuLex AI
ENVIRONMENT=development

DB_HOST=localhost
DB_PORT=5432
DB_NAME=hulex_ai
DB_USER=hulex_app
DB_PASSWORD=your_database_password

JWT_SECRET=your_jwt_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Default: local Ollama if no API key is supplied. Install Ollama and pull the model.
# HULEX_REWRITE_PROVIDER=ollama
# HULEX_OLLAMA_MODEL=qwen2.5:7b
# Optional cloud rewriting:
# HULEX_REWRITE_PROVIDER=openai
# HULEX_REWRITE_API_KEY=your_private_key
# HULEX_REWRITE_MODEL=gpt-4o-mini
# Explicit basic cleanup only: HULEX_REWRITE_PROVIDER=polish
